      "source": [
        "from scipy import stats\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "scores_p5 = {}\n",
        "for name, fn in methods:\n",
        "    if name == \"dummy_random\":\n",
        "        continue\n",
        "    vals = []\n",
        "    for _, row in eval_cases.iterrows():\n",
        "        rec = fn(\n",
        "            row[\"query_ids\"], k=5,\n",
        "            age=row[\"age\"], gender=row[\"gender\"],\n",
        "            liked_train_ids=None, user_id=None,\n",
        "        )\n",
        "        vals.append(precision_at_k(rec, row[\"relevant_ids\"], 5))\n",
        "    scores_p5[name] = np.asarray(vals)\n",
        "\n",
        "base = scores_p5[\"baseline_overlap_mean\"]\n",
        "rows = []\n",
        "for name, s in scores_p5.items():\n",
        "    p = np.nan if name == \"baseline_overlap_mean\" else float(stats.ttest_rel(s, base).pvalue)\n",
        "    rows.append({\n",
        "        \"method\": name,\n",
        "        \"P@5 moyen\": s.mean(),\n",
        "        \"variance\": s.var(ddof=1),\n",
        "        \"écart-type\": s.std(ddof=1),\n",
        "        \"lift vs baseline\": s.mean() - base.mean(),\n",
        "        \"p vs baseline\": p,\n",
        "    })\n",
        "\n",
        "var_df = pd.DataFrame(rows)\n",
        "print(f\"P@5 mode produit — {len(eval_cases)} cas (sans dummy)\\n\")\n",
        "display(var_df.round(4))\n",
        "\n",
        "print(\"\\nLecture :\")\n",
        "for _, r in var_df.iterrows():\n",
        "    if r[\"method\"] == \"baseline_overlap_mean\":\n",
        "        print(f\"• Baseline : {r['P@5 moyen']:.1%} (référence).\")\n",
        "        continue\n",
        "    ok = r[\"lift vs baseline\"] > 0 and r[\"p vs baseline\"] < 0.05\n",
        "    print(\n",
        "        f\"• {r['method']} : {r['P@5 moyen']:.1%} \"\n",
        "        f\"(lift {r['lift vs baseline']:+.1%}) → {'utile' if ok else 'pas mieux que la baseline'}.\"\n",
        "    )\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 3.5))\n",
        "x = np.arange(len(var_df))\n",
        "ax.bar(x, var_df[\"P@5 moyen\"], yerr=var_df[\"écart-type\"], capsize=3, color=\"#3d5a80\")\n",
        "ax.axhline(base.mean(), color=\"#ee6c4d\", ls=\"--\", label=\"baseline\")\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(var_df[\"method\"], rotation=20, ha=\"right\")\n",
        "ax.set_ylabel(\"P@5\")\n",
        "ax.set_ylim(0, 0.8)\n",
        "ax.set_title(\"P@5 ± écart-type — vs baseline\")\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
