      "source": [
        "from collections import Counter\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "pop = film_stats.set_index(\"item_id\")[\"n_ratings\"]\n",
        "pop_rank = pop.rank(method=\"min\", ascending=False).astype(int)\n",
        "\n",
        "\n",
        "cmp_methods = [\n",
        "    (\"baseline\", recommend_baseline),\n",
        "    (\"film_cf\", recommend_film_cf),\n",
        "    (\"user_cf\", recommend_user_cf),\n",
        "    (\"hybrid\", recommend_hybrid),\n",
        "]\n",
        "\n",
        "recs = {}\n",
        "for name, fn in cmp_methods:\n",
        "    recs[name] = []\n",
        "    for _, row in eval_cases.iterrows():\n",
        "        recs[name].append(\n",
        "            fn(\n",
        "                row[\"query_ids\"], k=5,\n",
        "                age=row[\"age\"], gender=row[\"gender\"],\n",
        "                liked_train_ids=None, user_id=None,\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "def pop_bucket(mid):\n",
        "    r = int(pop_rank.get(mid, 10**9))\n",
        "    if r <= 20:\n",
        "        return \"top 20\"\n",
        "    if r <= 100:\n",
        "        return \"top 21–100\"\n",
        "    return \"hors top 100\"\n",
        "\n",
        "\n",
        "# Part des slots reco dans chaque tranche de popularité\n",
        "bucket_order = [\"top 20\", \"top 21–100\", \"hors top 100\"]\n",
        "rows = []\n",
        "for name, _ in cmp_methods:\n",
        "    flat = [m for r in recs[name] for m in r]\n",
        "    n = len(flat)\n",
        "    counts = Counter(pop_bucket(m) for m in flat)\n",
        "    row = {\"method\": name}\n",
        "    for b in bucket_order:\n",
        "        row[b] = counts[b] / n\n",
        "    row[\"rang pop. médian\"] = float(np.median([pop_rank.get(m, np.nan) for m in flat]))\n",
        "    rows.append(row)\n",
        "\n",
        "bucket_df = pd.DataFrame(rows)\n",
        "print(\"Où se situent les films recommandés ? (part des slots du top-5)\\n\")\n",
        "display(bucket_df.round(3))\n",
        "\n",
        "# Stacked bar — illustration claire\n",
        "fig, ax = plt.subplots(figsize=(8, 4))\n",
        "x = np.arange(len(bucket_df))\n",
        "colors = {\"top 20\": \"#ee6c4d\", \"top 21–100\": \"#e9c46a\", \"hors top 100\": \"#2a9d8f\"}\n",
        "bottom = np.zeros(len(bucket_df))\n",
        "for b in bucket_order:\n",
        "    vals = bucket_df[b].to_numpy()\n",
        "    ax.bar(x, vals, bottom=bottom, label=b, color=colors[b])\n",
        "    bottom += vals\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(bucket_df[\"method\"])\n",
        "ax.set_ylabel(\"Part des recommandations\")\n",
        "ax.set_ylim(0, 1)\n",
        "ax.set_title(\"Les reco viennent-elles du top popularité ?\")\n",
        "ax.legend(loc=\"upper right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Exemples hybride\n",
        "print(\"Exemples — films les plus souvent proposés par l'hybride :\")\n",
        "cnt = Counter(m for r in recs[\"hybrid\"] for m in r)\n",
        "for mid, c in cnt.most_common(6):\n",
        "    print(f\"  {c}×  {pop_bucket(mid):12s}  rang={pop_rank[mid]:3d}  {movie_title.get(mid)}\")\n",
        "\n",
        "print(\n",
        "    \"\"\"\n",
        "Lecture : plus la barre est orange, plus le modèle recycle le top-20\n",
        "des films les plus notés. User-CF / hybride restent très « top 20 » ;\n",
        "Film-CF descend davantage hors top 100 (plus exploratoire).\n",
        "\"\"\"\n",
        ")\n"
      ]
